# Ярмарка «4 сезона» — переменные доступа к Supabase (шаблон).
# Скопируйте в `.env.supabase` (добавлен в .gitignore) и заполните реальными значениями.
# Реальные значения в репозиторий НЕ коммитить.

# Персональный токен доступа Supabase (Management API).
# Создаётся: Supabase Dashboard → Account → Access Tokens.
# Нужен для `supabase link` / `db push` / `functions deploy` из песочницы.
SUPABASE_ACCESS_TOKEN=

# Короткий идентификатор проекта (project ref) — виден в URL дашборда.
SUPABASE_PROJECT_REF=

# URL проекта.
SUPABASE_URL=https://<project-ref>.supabase.co

# Публичный anon-ключ (Project Settings → API). Используется в браузере.
SUPABASE_ANON_KEY=

# Секретный service_role-ключ (Project Settings → API).
# Только для серверных скриптов (миграции/seed/создание админа); в браузер не попадает.
SUPABASE_SERVICE_ROLE_KEY=

# Учётка администратора ярмарки (Auth → Users → Add user).
# Используется в E2E-входе и добавляется в public.admin_users.
FAIR_ADMIN_EMAIL=
FAIR_ADMIN_PASSWORD=
